# MindCare Node.js Chat API. Salin file ini ke backend/.env.
NODE_ENV=development
HOST=0.0.0.0
PORT=8000
TRUST_PROXY=false

# Origin frontend lokal; saat deploy, ganti dengan URL frontend yang tepat.
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500

# Isi sendiri dengan API key dari NVIDIA Build. Jangan commit backend/.env.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TIMEOUT=120
NVIDIA_MAX_TOKENS=700
NVIDIA_REASONING_EFFORT=none
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95

# Rate limit in-memory untuk server tunggal.
CHAT_RATE_LIMIT=8
CHAT_RATE_WINDOW_MS=60000
