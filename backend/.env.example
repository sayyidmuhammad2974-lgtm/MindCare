# Backend Environment Variables
# Copy to .env for local development
# DO NOT COMMIT .env - add to .gitignore

# Required: NVIDIA API Key (get from https://build.nvidia.com)
NVIDIA_API_KEY=

# Optional: NVIDIA API Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TIMEOUT=120
NVIDIA_MAX_TOKENS=700
NVIDIA_REASONING_EFFORT=none
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95

# Server Configuration
HOST=0.0.0.0
PORT=8000
TRUST_PROXY=false

# CORS: Frontend URL(s) - comma separated
# For local dev with Live Server (port 5500):
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500
# For production (update after Cloudflare Pages deploy):
# FRONTEND_URL=https://mindcare-frontend.pages.dev

# Rate Limiting
CHAT_RATE_LIMIT=8
CHAT_RATE_WINDOW_MS=60000